# Required application infrastructure
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Server-only YouCam credentials. Never prefix these with NEXT_PUBLIC_.
YOUCAM_API_KEY="set-locally-never-commit-real-keys"
YOUCAM_API_BASE_URL="https://yce-api-01.makeupar.com"
YOUCAM_UNIT_RESERVE="100"

# Optional existing Openfront storage configuration
S3_BUCKET_NAME=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# Paid payment and model providers are intentionally not required for FitFront.
